{
  "name": "vedaai-backend",
  "version": "1.0.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "start:dev": "ts-node src/index.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "ts-node src/worker.ts",
    "test": "ts-node test/model.test.ts && ts-node test/api.test.ts && ts-node test/classroom.test.ts && ts-node test/grading.test.ts && ts-node test/queue.test.ts && ts-node test/migration.test.ts && ts-node test/provider-fallback.test.ts && ts-node test/objective-grading.test.ts && ts-node test/source.test.ts && ts-node test/review.test.ts && ts-node test/rubric-evaluation.test.ts",
    "test:live": "ts-node test/live.test.ts",
    "test:pdf": "ts-node --compiler-options '{\"lib\":[\"ES2020\",\"DOM\"]}' test/pdf.test.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.2",
    "pg": "^8.23.1",
    "uuid": "^9.0.0",
    "ws": "^8.16.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
